<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>mptc.seangleng</groupId>
    <artifactId>ecommerce-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!--To Build submodule - JAR File-->
    <packaging>pom</packaging>
    <name>ecommerce-system</name>
    <description>ecommerce-system</description>

    <!--big-submodule-->
    <modules>
        <module>common</module>
        <module>order-service</module>
    </modules>

    <properties>
        <!--Can change later-->
        <java.version>25</java.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    </properties>

    <dependencies>
        <!--Add more dependencies-->
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>mptc.seangleng</groupId>
                <artifactId>common-domain</artifactId>
                <!--declare version of dependency to all of module which always use the version the same as parent!-->
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>mptc.seangleng</groupId>
                <artifactId>order-domain-core</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--It is about compilation-->
            <plugin>
                <!--Spring boot need springboot main class-->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
